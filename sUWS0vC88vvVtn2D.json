      {
        "parameters": {
          "jsCode": "const buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst config = $('Config').first().json;\nconst message = config.message || {};\nconst photos = message.photo || [];\nconst fileId = photos.length ? String(photos[photos.length - 1].file_id) : '';\nreturn [{\n  json: {\n    update_id: config.update_id,\n    telegram_user_id: String((message.from && message.from.id) || ''),\n    chat_id: String((message.chat && message.chat.id) || ''),\n    text: '',\n    photo_caption: message.caption || '',\n    photo_file_id: fileId,\n    photo_base64: buffer.toString('base64'),\n    photo_name: 'telegram.jpg'\n  }\n}];"
