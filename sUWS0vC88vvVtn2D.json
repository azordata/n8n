        "jsCode": "const item = $input.first().json;\nconst status = item.statusCode || item.status || 0;\nconst token = String(($('Config').first().json.apiToken) || '').trim();\nlet raw = item.body;\nif (raw === undefined || raw === null) raw = item.data;\nif (typeof raw !== 'string') {\n  try { raw = JSON.stringify(raw || ''); } catch (error) { raw = String(raw || ''); }\n}\nlet reply = 'No he podido completar la operacion.';\nif (!token || token === 'PEGAR_TOKEN_DE_ODOO' || token === 'PEGAR_TOKEN_DEL_BOT' || token === 'PEGAR_TOKEN_DE_BOTFATHER') {\n  reply = 'En el nodo Config, apiToken y telegramBotToken tienen que ser el token de BotFather, el mismo que pegaste en Odoo, Peritaje, Ajustes.';\n} else {\n  try {\n    const parsed = JSON.parse(raw);\n    reply = (parsed && (parsed.reply || parsed.error)) || reply;\n  } catch (error) {\n    const snippet = String(raw || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 180);\n    if (!String(raw || '').trim()) {\n      reply = 'Odoo no ha respondido. En el nodo Config, odooBaseUrl tiene que ser la URL del build, sin barra final.';\n    } else if (/<html|<!doctype/i.test(raw)) {\n      reply = 'Odoo ha devuelto una pagina web, no el bot. Revisa odooBaseUrl y que el modulo Peritaje este actualizado.';\n    } else {\n      reply = 'Respuesta no valida de Odoo' + (status ? ' (' + status + ')' : '') + (snippet ? ': ' + snippet : '');\n    }\n  }\n  if (status === 401 && !/token/i.test(reply)) {\n    reply = 'Odoo ha rechazado el token (' + token.length + ' caracteres). Tiene que ser el campo Token de la API, no el token del bot.';\n  }\n}\nreturn [{ json: { reply, status } }];"
      },
